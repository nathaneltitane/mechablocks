#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_local=/media/internal/Lego
directory_models_local="${directory_local}"/models

directory_server="${PWD}"
directory_models_server="${directory_server}"/models
directory_images_server="${directory_server}"/images
directory_javascript_server="${directory_server}"/javascript

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

synchronize () {

	source="${1}"
	destination="${2}"

	rsync				\
		--archive		\
		--quiet			\
		--recursive		\
						"${source}" "${destination}" > "${sink}" 2>&1

}

# background ───────────────────────────────────────────────────────────────────

# prepare update

frobulator.directory "${directory_server}" images

frobulator.fwd "Copying..."

# values

list_extensions+=(
	png
)

for extension in ${list_extensions[@]}
do
	list_directories=(
		flat
		overlay
		social
		thumbnail
	)

	for directory in ${list_directories[@]}
	do
		frobulator.directory "${directory_images_server}" "${directory}"

		count_images=0

		# set IFS

		IFS=$'\n'

		# shuffle models directories list:
		# creates random showcase of all models on each update

		for path_image in $(find ${directory_models_local} -type f -not -path "work-in-progress" -iname "${directory}"."${extension}" | sort)
		do
			# get model directory

			directory_model="${path_image%/*/*/*}"

			if [ -f "${directory_model}"/background ]
			then

				number_image=$(printf "%03d" "${count_images}")

				# get model image base directory from path

				directory_image="${path_image%/*}"

				# get model image file name from path

				file_image="${path_image##*/}"

				# get model image file extension from path

				extension_image="${file_image##*.}"

				# strip extension from model file name

				name_image="${file_image%.*}"

				# set synchronization paths

				path_local="${path_image}"

				path_server="${directory_images_server}"/${directory}/${name_image}-"${number_image}"."${extension}"

				synchronize "${path_image}" "${path_server}"
			fi

			(( count_images ++ ))

		done

	done

	# reset IFS

	IFS=''

done

# update random background generator with new image file count

frobulator.inf "Updating" "[ Images ]"

sed															\
	-i														\
	-e "s/var count = .*/var count = ${count_images};/g"		\
															"${directory_javascript_server}"/background.js

frobulator.inf "Models" "[ ${count_images} ]"

frobulator.cpt "Complete" "[ Images ]"

#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

local_directory=/media/internal/Lego
local_models_directory="${local_directory}"/models

server_directory="${PWD}"
server_models_directory="${server_directory}"/models
server_images_directory="${server_directory}"/images
server_javascript_directory="${server_directory}"/javascript

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

synchronize () {

	source="${1}"
	destination="${2}"

	rsync				\
		--archive		\
		--quiet			\
		--recursive		\
						"${source}" "${destination}" > "${sink}" 2>&1

}

# background ───────────────────────────────────────────────────────────────────

# prepare update

frobulator.directory "${server_directory}" images

frobulator.fwd "Copying..."

# values

extensions_list+=(
	png
)

for extension in ${extensions_list[@]}
do
	directories_list=(
		flat
		overlay
		social
		thumbnail
	)

	for directory in ${directories_list[@]}
	do
		frobulator.directory "${server_images_directory}" "${directory}"

		count=0

		# set IFS

		IFS=$'\n'

		# shuffle models directories list:
		# creates random showcase of all models on each update

		for image_path in $(find ${local_models_directory} -type f -not -path "work-in-progress" -iname "${directory}"."${extension}" | sort)
		do
			# get model directory

			model_directory="${image_path%/*/*/*}"

			if [ -f "${model_directory}"/background ]
			then

				image_count=$(printf "%03d" "${count}")

				# get model image base directory from path

				image_directory="${image_path%/*}"

				# get model image file name from path

				image_file="${image_path##*/}"

				# get model image file extension from path

				image_extension="${image_file##*.}"

				# strip extension from model file name

				image_name="${image_file%.*}"

				# set synchronization paths

				local_path="${image_path}"

				server_path="${server_images_directory}"/${directory}/${image_name}-"${image_count}"."${extension}"

				synchronize "${image_path}" "${server_path}"
			fi

			((count++))

		done

	done

	# reset IFS

	IFS=''

done

# update random background generator with new image file count

frobulator.inf "Updating" "[ Images ]"

sed															\
	-i														\
	-e "s/var count = .*/var count = ${count};/g"		\
															"${server_javascript_directory}"/background.js

frobulator.inf "Models" "[ ${count} ]"

frobulator.cpt "Complete" "[ Images ]"

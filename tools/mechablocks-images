#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

# load frobulator once

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# keep the sudo user home

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	# local copy and download

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# fetch the latest release

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	# keep only a newer release

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	# drop the download

	rm -f "${frobulator_download}"

	# stop without frobulator

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	# load the library

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# script and site folders

frobulator.locate

directory_root="${directory_script%/*}"

# local models

directory_local=/media/internal/Lego
directory_models_local="${directory_local}"/models

# site images and scripts

directory_server="${directory_root}"
directory_models_server="${directory_server}"/models
directory_images_server="${directory_server}"/resources/images
directory_javascript_server="${directory_server}"/resources/javascript

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

synchronize () {

	# use to copy one image

	source="${1}"
	destination="${2}"

	rsync			\
		--archive	\
		--quiet		\
		--recursive	\
						"${source}" "${destination}" > "${sink}" 2>&1

}

# background ───────────────────────────────────────────────────────────────────

# site images folder

frobulator.directory "${directory_server}" resources/images

frobulator.fwd "Copying..."

# image types

list_extensions+=(
	png
)

for extension in ${list_extensions[@]}
do
	# render views

	list_directories=(
		flat
		overlay
		social
		thumbnail
	)

	for directory in ${list_directories[@]}
	do
		# start each view empty

		if [ -d "${directory_images_server}/${directory}" ]
		then
			frobulator.delete "${directory_images_server}" "${directory}"
		fi

		frobulator.directory "${directory_images_server}" "${directory}"

		# images copied so far

		count_images=0

		# finished model renders

		mapfile -t list_paths_image < <(find "${directory_models_local}" -type f -not -path "*/work-in-progress/*" -iname "${directory}.${extension}" | sort)

		for path_image in "${list_paths_image[@]}"
		do
			# model folder

			directory_model="${path_image%/*/*/*}"

			# background models only

			if [ -f "${directory_model}"/background ]
			then
				# padded image number

				number_image=$(printf "%03d" "${count_images}")

				# image folder

				directory_image="${path_image%/*}"

				# image file name

				file_image="${path_image##*/}"

				# image extension

				extension_image="${file_image##*.}"

				# name without extension

				name_image="${file_image%.*}"

				# copy paths

				path_local="${path_image}"

				path_server="${directory_images_server}"/${directory}/${name_image}-"${number_image}"."${extension}"

				synchronize "${path_image}" "${path_server}"

				# numbering without gaps

				(( count_images ++ ))
			fi

		done

	done

done

# image count for the backgrounds

frobulator.inf "Updating" "[ Images ]"

sed															\
	-i														\
	-e "s/var count = .*/var count = ${count_images};/g"	\
															"${directory_javascript_server}"/background.js

frobulator.inf "Models" "[ ${count_images} ]"

frobulator.cpt "Complete" "[ Images ]"

#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

# load frobulator once

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# keep the sudo user home

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	# local copy and download

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# fetch the latest release

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	# keep only a newer release

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	# drop the download

	rm -f "${frobulator_download}"

	# stop without frobulator

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	# load the library

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# variables ────────────────────────────────────────────────────────────────────

# script and site folders

frobulator.locate

directory_root="${directory_script%/*}"

# site paths are relative - no path arguments

cd -- "${directory_root}" || exit 1

# site identity

directory_server="${directory_root}"

address_site='https://mechablocks.com'

name_site='MechaBlocks'

name_site_stylized='MECHA // BLOCKS'

description_site='Custom LEGO® Mecha MOCs, 3D Viewer & Building Instructions'

slogan_site='Where LEGO® meets Open Source'

path_logo='resources/logo/logo-red.png'

# output and homepage

file_sitemap='sitemap.xml'

file_homepage='./index.html'

# schema block markers

marker_schema_begin='<!-- schema-itemlist-begin -->'

marker_schema_end='<!-- schema-itemlist-end -->'

# folders kept out of the sitemap

list_directories_excluded=(
	'./.git/'
	'./.github/'
	'./node_modules/'
	'./assets/'
	'./exports/'
	'./renders/'
	'./resources/'
)

# folders listed in the schema

list_directories_schema=(
	'./models/'
)

# defaults ─────────────────────────────────────────────────────────────────────

# site address without a trailing slash

url_site="${address_site%/}"

# counters and schema list

count_pages=0

position=0

list_urls_schema=()

# functions ────────────────────────────────────────────────────────────────────

directory_excluded_check () {

	# use to test an excluded folder

	path_file="${1}"

	for path_directory in "${list_directories_excluded[@]}"
	do
		if [[ "${path_file}" == "${path_directory}"* ]]
		then
			return 0
		fi
	done

	return 1

}

schema_included_check () {

	# use to test a schema folder

	path_file="${1}"

	for path_directory in "${list_directories_schema[@]}"
	do
		if [[ "${path_file}" == "${path_directory}"* ]]
		then
			return 0
		fi
	done

	return 1

}

url_prepare () {

	# use to turn a path into url_full

	path_url="${1}"

	# drop index file and slashes

	path_url="${path_url#./}"
	path_url="${path_url#index.html}"
	path_url="${path_url%index.html}"
	path_url="${path_url%/}"

	# site root or folder url

	if [ "${path_url}" = "." ] ||
	   [ "${path_url}" = ""  ]
	then
		path_url="/"
	else
		path_url="/${path_url}/"
	fi

	path_url="${path_url//\/\//\/}"

	url_full="${url_site}${path_url}"

}

url_index () {

	# use to add a page to the sitemap

	url_prepare "${1}"

	path_file="${2}"

	# page date and crawl hints

	date_modified="$(date -u -r "${path_file}" '+%Y-%m-%d')"

	frequency_change="weekly"

	priority="0.80"

	# sitemap entry

	cat >> "${file_sitemap}" << URL

	<url>

		<loc>${url_full}</loc>

		<lastmod>${date_modified}</lastmod>

		<changefreq>${frequency_change}</changefreq>

		<priority>${priority}</priority>

	</url>
URL

	(( count_pages ++ ))

}

schema_itemlist_write () {

	# use to write the schema block

	file_schema="${1}"

	count_schema="${#list_urls_schema[@]}"

	# site, organization and collection

	cat > "${file_schema}" << SCHEMA-BEGIN

		<script type="application/ld+json">

		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebSite",
					"@id": "${address_site}/#website",
					"name": "${name_site}",
					"alternateName": "${name_site_stylized}",
					"url": "${address_site}/",
					"description": "${description_site}",
					"publisher": {
						"@id": "${address_site}/#organization"
					}
				},
				{
					"@type": "Organization",
					"@id": "${address_site}/#organization",
					"name": "${name_site}",
					"alternateName": "${name_site_stylized}",
					"url": "${address_site}/",
					"slogan": "${slogan_site}",
					"logo": {
						"@type": "ImageObject",
						"url": "${address_site}/${path_logo}"
					},
					"founder": {
						"@type": "Person",
						"name": "Nathanel Titane"
					}
				},
				{
					"@type": "BreadcrumbList",
					"@id": "${address_site}/#breadcrumbs",
					"itemListElement": [
						{
							"@type": "ListItem",
							"position": 1,
							"name": "Home",
							"item": "${address_site}/"
						}
					]
				},
				{
					"@type": "CollectionPage",
					"@id": "${address_site}/#collection",
					"name": "${name_site} - LEGO® Mecha MOCs",
					"url": "${address_site}/",
					"description": "${description_site}",
					"isPartOf": {
						"@id": "${address_site}/#website"
					},
					"mainEntity": {
						"@type": "ItemList",
						"numberOfItems": ${count_schema},
						"itemListElement": [
SCHEMA-BEGIN

	# one item per model page

	for url_schema in "${list_urls_schema[@]}"
	do
		(( position ++ ))

		# comma between items

		if [ "${position}" -lt "${count_schema}" ]
		then
			separator=','
		else
			separator=''
		fi

		cat >> "${file_schema}" << SCHEMA-ITEM
							{
								"@type": "ListItem",
								"position": ${position},
								"url": "${url_schema}"
							}${separator}
SCHEMA-ITEM
	done

	# close the block

	cat >> "${file_schema}" << SCHEMA-END
						]
					},
					"breadcrumb": {
						"@id": "${address_site}/#breadcrumbs"
					}
				}
			]
		}
SCHEMA-END

}

schema_homepage_update () {

	# use to put the schema in the homepage

	# stop without a homepage

	if [ ! -f "${file_homepage}" ]
	then
		frobulator.wrn "Homepage not found" "[ ${file_homepage} ]"

		return 1
	fi

	# stop without both markers

	if [ "$(grep -c "${marker_schema_begin}" "${file_homepage}")" -eq 0 ] ||
	   [ "$(grep -c "${marker_schema_end}" "${file_homepage}")" -eq 0 ]
	then
		frobulator.wrn "Schema markers not found" "[ ${file_homepage} ]"

		return 1
	fi

	# temporary schema and page

	file_schema="$(mktemp)"

	file_homepage_output="$(mktemp)"

	schema_itemlist_write "${file_schema}"

	# swap the block between the markers

	awk												\
		-v marker_begin="${marker_schema_begin}"	\
		-v marker_end="${marker_schema_end}"		\
		-v file_schema="${file_schema}"				\
		'
			index($0, marker_begin) {
				print

				while ((getline line < file_schema) > 0) {
					print line
				}

				skip = 1

				next
			}

			index($0, marker_end) {
				skip = 0

				print

				next
			}

			skip != 1 {
				print
			}
		' "${file_homepage}" > "${file_homepage_output}"

	# replace the page, drop the schema

	mv "${file_homepage_output}" "${file_homepage}"

	rm -f "${file_schema}"

	frobulator.inf "Schema updated" "[ ${file_homepage} ]"

}

# initialize ───────────────────────────────────────────────────────────────────

frobulator.fwd "Writing..."

# write header ─────────────────────────────────────────────────────────────────

cat > "${file_sitemap}" << HEADER
<?xml version="1.0" encoding="UTF-8"?>

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
HEADER

# index pages ──────────────────────────────────────────────────────────────────

# every index page, one per line

IFS=$'\n'

list_files_index=$(find . -type f -name 'index.html' | sort)

for path_file in ${list_files_index}
do
	# skip excluded folders

	directory_excluded_check "${path_file}"

	status_excluded="${?}"

	if [ "${status_excluded}" -eq 0 ]
	then
		continue
	fi

	# sitemap entry

	url_index "${path_file}" "${path_file}"

	# schema entry for model pages

	schema_included_check "${path_file}"

	status_included="${?}"

	if [ "${status_included}" -eq 0 ]
	then
		url_prepare "${path_file}"

		list_urls_schema+=("${url_full}")
	fi
done

unset IFS

# write schema ─────────────────────────────────────────────────────────────────

schema_homepage_update

# write footer ─────────────────────────────────────────────────────────────────

cat >> "${file_sitemap}" << FOOTER

</urlset>
FOOTER

# report ───────────────────────────────────────────────────────────────────────

# stop when nothing was found

if [ "${count_pages}" -eq 0 ]
then
	frobulator.err "No URLs found" "[ ${url_site} ]"

	frobulator.wrn "Script must be run from site root directory."

	exit 1
else
	frobulator.inf "Sitemap written" "[ ${file_sitemap} ]"

	frobulator.inf "URL count" "[ ${count_pages} ]"

	frobulator.inf "Schema URL count" "[ ${#list_urls_schema[@]} ]"

	frobulator.cpt "Complete" "[ Sitemap ]"
fi

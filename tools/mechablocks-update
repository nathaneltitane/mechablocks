#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

# load frobulator once

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# keep the sudo user home

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	# local copy and download

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# fetch the latest release

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	# keep only a newer release

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	# drop the download

	rm -f "${frobulator_download}"

	# stop without frobulator

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	# load the library

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--directory)
			directory="${2}"

			shift
		;;

		-a|--all)
			option="all"
		;;

		-e|--export)
			option="exports"
		;;

		-r|--render)
			option="renders"
		;;

		-s|--instructions)
			option="instructions"
		;;

		-m|--models)
			option="models"
		;;

		-i|--images)
			option="images"
		;;

		-w|--drawer)
			option="drawer"
		;;

		-u|--menu)
			option="menu"
		;;

		-v|--viewer)
			option="viewer"
		;;

		-x|--index)
			option="index"
		;;

		-f|--feed)
			option="feed"
		;;

		-b|--bricklink)
			option="bricklink"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} [DIRECTORY] | [OPTION] [PARAMETER]"
			echo
			echo -e "Options:"
			echo
			echo -e "Note:                 Without an option, every step runs."
			echo
			echo -e "-d, --directory       Specify [d]irectory to load models from."
			echo
			echo -e "-a, --all             Update [a]ll website framework and content."
			echo
			echo -e "-e, --export          Update models [e]xports content."
			echo
			echo -e "-r, --render          Update models [r]enders content."
			echo
			echo -e "-s, --instructions    Update models in[s]tructions content."
			echo
			echo -e "-m, --models          Update [m]odels content."
			echo
			echo -e "-i, --images          Update model [i]mages."
			echo
			echo -e "-w, --drawer          Update dra[w]er content."
			echo
			echo -e "-u, --menu            Update models men[u] content."
			echo
			echo -e "-v, --viewer          Update models [v]iewer content."
			echo
			echo -e "-x, --index           Update website inde[x]ing sitemap."
			echo
			echo -e "-f, --feed            Update model releases [f]eed."
			echo
			echo -e "-b, --bricklink       Update [b]ricklink store splash page."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} [DIRECTORY] | [OPTION] [PARAMETER]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# clear ────────────────────────────────────────────────────────────────────────

frobulator.clear

# variables ────────────────────────────────────────────────────────────────────

# script and site folders

frobulator.locate

directory_root="${directory_script%/*}"

# models folder for the tools

export directory="${directory}"

# tools folder

directory_tools="${directory_script}"

# defaults ─────────────────────────────────────────────────────────────────────

# without an option every step runs

option="${option:-all}"

# functions ────────────────────────────────────────────────────────────────────

upload () {

	# use to commit and push everything

	message="${1}"

	git -C "${directory_root}" add --all

	git -C "${directory_root}" commit	\
		--all	\
		--message="${message}"

	git -C "${directory_root}" push > "${sink}" 2>&1

	echo

}

option () {

	# use to run the listed tools

	for name_tool in "${list[@]}"
	do
		bash "${directory_tools}/${name_tool}"
	done

	# publish the results

	frobulator.fwd "Updating..."

	upload "Models update"

	list=()

}

# requirements ─────────────────────────────────────────────────────────────────

# needed commands

list+=(
	git
	rsync
)

frobulator.assess ${list[@]}

list=()

# update ───────────────────────────────────────────────────────────────────────

# every tool

if [[ "${option}" = "all" ]]
then
	list+=(
		mechablocks-social
		mechablocks-exports
		mechablocks-renders
		mechablocks-instructions
		mechablocks-models
		mechablocks-images
		mechablocks-drawer
#		mechablocks-menu
		mechablocks-viewer
		mechablocks-index
		mechablocks-feed
		mechablocks-bricklink
	)
fi

# one tool per option

if [[ "${option}" = "exports" ]]
then
	list+=(
		mechablocks-exports
	)
fi

if [[ "${option}" = "renders" ]]
then
	list+=(
		mechablocks-renders
	)
fi

if [[ "${option}" = "instructions" ]]
then
	list+=(
		mechablocks-instructions
	)
fi

if [[ "${option}" = "models" ]]
then
	list+=(
		mechablocks-models
	)
fi

if [[ "${option}" = "images" ]]
then
	list+=(
		mechablocks-images
	)
fi

if [[ "${option}" = "drawer" ]]
then
	list+=(
		mechablocks-drawer
	)
fi

if [[ "${option}" = "menu" ]]
then
	list+=(
		mechablocks-menu
	)
fi

if [[ "${option}" = "viewer" ]]
then
	list+=(
		mechablocks-viewer
	)
fi

if [[ "${option}" = "index" ]]
then
	list+=(
		mechablocks-index
	)
fi

if [[ "${option}" = "feed" ]]
then
	list+=(
		mechablocks-feed
	)
fi

if [[ "${option}" = "bricklink" ]]
then
	list+=(
		mechablocks-bricklink
	)
fi

# run and publish

option ${list[@]}

list=()

frobulator.scs "Done" "[ Update ]"

		elif [[ -f "${directory_model}"/work-in-progress ]]
		then
			color_logo="orange"

			unset class_status
		else
			color_logo="green"

			unset class_status
		fi

		if [[ -f "${directory_model}"/drawer ]]
		then

cat << MODEL-DRAWER-CONTENT ->> "${directory_modules}"/drawer.html


#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_models="${PWD}"/models
directory_modules="${PWD}"/modules

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

frobulator.inf "Generating model entries"

frobulator.fwd "Writing..."

# generate header

cat << 'MODELS-MENU-HEADER' -> "${directory_modules}/"menu.html
		<script>

			$(function(){

				$.get("/modules/anchors.html", function (data) {

					$("#anchors").append(data);

				});

				}
			);

		</script>

		<!-- BEGIN MODELS MENU -->

MODELS-MENU-HEADER

# values

list_extensions+=(
	kmz
)

for extension in ${list_extensions[@]}
do
	count_models=0

	# one model path per line - paths with spaces kept whole

	mapfile -t list_models < <(find "${directory_models}" -type f -iname "*.${extension}" ! -iname "*instructions*" | sort)

	for path_model in "${list_models[@]}"
	do
		path_model=$(echo "${path_model}" | cut -d '/' -f6-)

		# get model file name from path

		file_model="${path_model##*/}"

		# strip extension from model file name

		name_model="${file_model%.*}"

		# use model directory as root

		directory_model="${path_model%/*/*}"

		# define model output directories

		directory_render="${directory_model}"/renders

		directory_export="${directory_render}"/exports

		directory_flat="${directory_render}"/flat

		directory_thumbnail="${directory_render}"/thumbnail

		# thumbnail version - modification time in seconds - browsers reload changed files

		version_thumbnail="$(date -r "${directory_thumbnail}/thumbnail.png" +%s 2> "${sink}")"

		# define model specific directories

		title_category=$(cat "${directory_model%/*}"/title)

		title_model=$(cat "${directory_model}"/title)

		text_title=$(echo ${title_model//\<\/\br\>/})

		file_paypal="${directory_model}"/paypal

		id_paypal=$(cat "${file_paypal}")

		file_pieces="${directory_model}"/pieces

		count_pieces=$(cat "${file_pieces}")

		path_instructions="${directory_model}"/instructions

		file_price="${directory_model}"/price

		price_instructions=$(cat "${file_price}")

		# keep first container visible

		if [ "${count_models}" -eq 0 ]
		then
			class_hidden=""
		else
			class_hidden="hidden"
		fi

# generate model container

cat << MODEL-CONTAINER ->> "${directory_modules}/"menu.html
<!-- BEGIN CONTAINER -->

<div id="${text_title// /-}" class='container ${class_hidden}'>

	<div class='flex flex-column flex-center flex-around flex-wrap'>

		<div class='flex-cell'>

			<a href="${directory_model}">

				<img src="/${directory_thumbnail}/thumbnail.png?version=${version_thumbnail}"/>

			</a>

		</div>

	</div>

MODEL-CONTAINER

if [ -d "${path_instructions}" ]
then

cat << MODEL-TITLE ->> "${directory_modules}/"menu.html
	<div id="menu" class="menu section flex flex-column flex-stretch">

		<div class="category flex-cell text-left">

			${title_category}

		</div>

		<a class="container" href="${directory_model}/">

			<div class="flex flex-row flex-middle">

				<div class="flex">

					<div class="icon icon-flex icon-center logo-green"></div>

				</div>

				<div class="flex-cell text-center">

					${text_title}

				</div>

			</div>

		</a>

	</div>

</div>

<!-- END CONTAINER -->

MODEL-TITLE

else

cat << MODEL-TITLE ->> "${directory_modules}/"menu.html
	<div id="menu" class="menu section flex flex-column flex-stretch">

		<div class="category flex-cell text-left">

			${title_category}

		</div>

		<a class="container" href="${directory_model}/">

			<div class="flex flex-row flex-middle">

				<div class="flex">

					<div class="icon icon-flex icon-center logo-orange"></div>

				</div>

				<div class="flex-cell text-center">

					${text_title}

				</div>

			</div>

		</a>

	</div>

</div>

<!-- END CONTAINER -->

MODEL-TITLE

fi

	(( count_models ++ ))

	done
done

# generate footer

cat << FOOTER ->> "${directory_modules}/"menu.html
<!-- END MODELS MENU -->

<div id="anchors" class="section">

</div>

FOOTER

frobulator.inf "Models" "[ ${count_models} ]"

frobulator.cpt "Complete" "[ Menu ]"
